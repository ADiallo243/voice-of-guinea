NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key used for Owner-authorized team invitations. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
RESEND_API_KEY=
SOCIAL_PACK_FROM_EMAIL=Voice of Guinea <newsroom@voiceofguinea.com>
SOCIAL_PACK_TO_EMAIL=voiceofguinea@gmail.com
# Required for newsletter delivery. Turnstile is an optional additional anti-bot layer.
NEWSLETTER_FROM_EMAIL=Voice of Guinea <newsroom@voiceofguinea.com>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEWSLETTER_RATE_LIMIT_SECRET=replace-with-a-long-random-value
# Server-only secret used by Vercel Cron to publish due articles.
CRON_SECRET=replace-with-a-long-random-value
# Server-only HMAC secret used to throttle newsroom login attempts.
AUTH_RATE_LIMIT_SECRET=replace-with-a-different-long-random-value

# New features remain off until migrations and end-to-end checks pass.
NAYA_SUMMARIES_ENABLED=false
NAYA_CHAT_ENABLED=false
NEWSLETTER_POPUP_ENABLED=false
OPENAI_API_KEY=
NAYA_MODEL=gpt-4o-mini
NAYA_RATE_LIMIT_SECRET=
NAYA_DAILY_LIMIT=5
NAYA_GLOBAL_DAILY_LIMIT=1000
